# Copy to .env and fill in. NEVER commit the real .env.

# --- Required for live mode only -------------------------------------------
# Your wallet's private key, as a base58 string (Phantom "export private key")
# or a JSON byte array. Use a BURNER wallet funded with only what you are
# willing to lose. The key never leaves your machine.
WALLET_PRIVATE_KEY=

# A public RPC works for testing but will rate-limit you. For live trading use
# a paid endpoint (Helius, QuickNode, Triton).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- Optional ---------------------------------------------------------------
# Jupiter paid tier. Leave empty to use the free lite-api endpoints.
JUPITER_API_KEY=

# Telegram alerts on every buy/sell. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
